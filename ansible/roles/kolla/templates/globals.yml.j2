---
# /etc/kolla/globals.yml — généré par Ansible
# Documentation : https://docs.openstack.org/kolla-ansible/

# ─── Versions / images ─────────────────────────────────────────────────────
kolla_base_distro: "ubuntu"
openstack_release: "{{ openstack_release }}"

# ─── Réseau ─────────────────────────────────────────────────────────────────
kolla_internal_vip_address: "{{ kolla_internal_vip_address }}"
kolla_external_vip_address: "{{ kolla_external_vip_address }}"

network_interface: "{{ network_interface }}"
neutron_external_interface: "{{ neutron_external_interface }}"
storage_interface: "{{ storage_interface }}"

# Pas de TLS pour un lab
kolla_enable_tls_internal: "no"
kolla_enable_tls_external: "no"

# ─── Services activés ───────────────────────────────────────────────────────
enable_haproxy: "yes"
enable_keepalived: "yes"
enable_horizon: "{{ enable_horizon }}"
enable_cinder: "{{ enable_cinder }}"
enable_neutron_provider_networks: "{{ enable_neutron_provider_networks }}"
enable_heat: "{{ enable_heat }}"
enable_octavia: "{{ enable_octavia }}"

# ─── Backends Ceph (cluster externe géré par cephadm) ──────────────────────
glance_backend_ceph: "{{ glance_backend_ceph }}"
cinder_backend_ceph: "{{ cinder_backend_ceph }}"
nova_backend_ceph: "{{ nova_backend_ceph }}"

# ─── Neutron ────────────────────────────────────────────────────────────────
neutron_plugin_agent: "openvswitch"
enable_neutron_dvr: "no"

# ─── Nova ───────────────────────────────────────────────────────────────────
nova_compute_virt_type: "kvm"           # exige nested virt activée dans VMware
nova_console: "novnc"
